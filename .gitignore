# Ignore Node.js dependencies and build artifacts
node_modules/
dist/
build/

# Ignore compiled Java class files
*.class

# Ignore compiled Python bytecode
__pycache__/
*.py[cod]

# Ignore log files
*.log

# Ignore package files
*.jar

# Ignore Maven build directory
target/

# Ignore JetBrains IDE settings
.idea/

# Ignore unit test reports
TEST*.xml

# Ignore OS-generated files
.DS_Store
Thumbs.db

# Ignore application binaries
*.app
*.exe
*.war

# Ignore large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Ignore local Netlify folder
.netlify/

# Ignore Node.js lock file (should usually be committed)
package-lock.json

# Ignore Yarn lock file (if using Yarn)
yarn.lock

# Ignore environment files (if applicable)
.env
.env.local
.env.production
.env.test

# bitbucket-pipelines.yml

